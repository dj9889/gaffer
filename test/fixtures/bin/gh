#!/usr/bin/env node
// A fake `gh` over a real bare git origin, for testing the PR → CI → merge path.
//   FAKE_GH_ORIGIN       bare repo that `origin` points at
//   FAKE_GH_STATE        directory for PR and CI state
//   FAKE_GH_CI           shell command CI runs in a checkout of the PR head
//   FAKE_GH_CHECK_LAG    number of `pr checks` calls that report no checks yet (registration lag)
//   FAKE_GH_MERGE_ERROR  if set, `pr merge` fails with this message
import { execFileSync, spawnSync } from "node:child_process";
import { existsSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

const env = process.env;
const statePath = join(env.FAKE_GH_STATE, "state.json");
const state = existsSync(statePath) ? JSON.parse(readFileSync(statePath, "utf8")) : { prs: [], runs: {}, checkCalls: 0 };
const save = () => writeFileSync(statePath, JSON.stringify(state, null, 1));
const git = (args, cwd) => execFileSync("git", args, { cwd, encoding: "utf8" }).trim();
const [cmd, sub, ...rest] = process.argv.slice(2);
const flag = (name) => (rest.includes(name) ? rest[rest.indexOf(name) + 1] : undefined);
const prFor = (url) => state.prs.find((p) => p.url === url) ?? fail(`no pull request found for ${url}`);
function fail(msg, code = 1) {
  process.stderr.write(msg + "\n");
  process.exit(code);
}

/** Run CI for the PR's current head, once per commit. */
function ci(pr) {
  const sha = git(["rev-parse", pr.head], env.FAKE_GH_ORIGIN);
  if (!state.runs[sha]) {
    const dir = mkdtempSync(join(tmpdir(), "fake-ci-"));
    git(["clone", "-q", "--branch", pr.head, env.FAKE_GH_ORIGIN, dir]);
    const r = spawnSync("sh", ["-c", env.FAKE_GH_CI ?? "true"], { cwd: dir, encoding: "utf8" });
    state.runs[sha] = { id: String(1000 + Object.keys(state.runs).length), ok: r.status === 0, log: (r.stdout + r.stderr).slice(-6000) };
    save();
  }
  const run = state.runs[sha];
  return [{ name: "ci", bucket: run.ok ? "pass" : "fail", link: `https://github.com/${pr.repo}/actions/runs/${run.id}/job/1` }];
}

function checks(pr) {
  state.checkCalls++;
  save();
  return state.checkCalls <= Number(env.FAKE_GH_CHECK_LAG ?? 0) ? [] : ci(pr);
}

if (cmd === "pr" && sub === "create") {
  const repo = flag("--repo");
  const pr = { n: state.prs.length + 1, repo, head: flag("--head"), base: flag("--base"), title: flag("--title"), body: flag("--body"), merged: false };
  pr.url = `https://github.com/${repo}/pull/${pr.n}`;
  state.prs.push(pr);
  save();
  console.log(pr.url);
} else if (cmd === "pr" && sub === "checks") {
  const pr = prFor(rest[0]);
  const list = checks(pr);
  if (rest.includes("--json")) {
    if (!list.length) fail(`no checks reported on the '${pr.head}' branch`);
    console.log(JSON.stringify(list));
  } else {
    if (!list.length) fail(`no checks reported on the '${pr.head}' branch`);
    process.exit(list.every((c) => c.bucket === "pass") ? 0 : 1);
  }
} else if (cmd === "run" && sub === "view") {
  const run = Object.values(state.runs).find((r) => r.id === rest[0]) ?? fail(`run ${rest[0]} not found`);
  console.log(run.log);
} else if (cmd === "pr" && sub === "ready") {
  // no-op
} else if (cmd === "pr" && sub === "merge") {
  const pr = prFor(rest[0]);
  if (env.FAKE_GH_MERGE_ERROR) fail(env.FAKE_GH_MERGE_ERROR);
  if (rest.includes("--delete-branch")) fail(`failed to delete local branch: '${pr.base}' is already checked out at another worktree`);
  const dir = mkdtempSync(join(tmpdir(), "fake-merge-"));
  git(["clone", "-q", "--branch", pr.base, env.FAKE_GH_ORIGIN, dir]);
  git(["fetch", "-q", "origin", pr.head], dir);
  git(["merge", "--squash", "FETCH_HEAD"], dir);
  git(["-c", "user.name=github", "-c", "user.email=noreply@github.com", "commit", "-qm", `${pr.title} (#${pr.n})`], dir);
  git(["push", "-q", "origin", pr.base], dir);
  pr.merged = true;
  save();
} else {
  fail(`fake gh: unsupported command: ${process.argv.slice(2).join(" ")}`, 2);
}
